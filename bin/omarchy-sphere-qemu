#!/bin/bash

# omarchy:summary=Run a sphere's virtual machine in the foreground
# omarchy:args=<sphere>
# omarchy:hidden=true

set -euo pipefail
source "$OMARCHY_PATH/default/spherie/lib.sh"

sphere_load "$1"

append="root=/dev/vda rw console=ttyS0 quiet spherie.name=$NAME spherie.role=$ROLE"
devices=()

nic() {
  local index="$1"
  devices+=(
    -netdev "tap,id=n$index,ifname=$(sphere_tap "$NAME" "$index"),script=no,downscript=no"
    -device "virtio-net-pci,netdev=n$index,mac=$(sphere_mac "$CID" "$index")"
  )
}

case "$NET" in
  none) ;;
  uplink)
    if [[ -n $VFIO ]]; then
      for pci in $VFIO; do
        devices+=(-device "vfio-pci,host=$pci")
      done
    else
      # Dev fallback: uplink is a host tap NATed by the host.
      nic 0
      append+=" spherie.devuplink=1"
    fi
    ;;
  *) nic 0 ;;
esac

[[ -n $SERVES ]] && nic 1

if [[ $NAME == "template" ]]; then
  # Updates write into the next template, swapped in after a clean shutdown.
  devices+=(-drive "file=$SPHERIE_DATA/template.next.qcow2,if=virtio,format=qcow2")
else
  # Root resets every boot: writes land in a throwaway overlay.
  devices+=(-drive "file=$SPHERIE_DATA/template.qcow2,if=virtio,format=qcow2,snapshot=on")
  devices+=(-drive "file=$SPHERIE_DATA/home/$NAME.qcow2,if=virtio,format=qcow2")
fi

export TMPDIR="/var/tmp/spherie"
exec qemu-system-x86_64 \
  -name "spherie-$NAME,process=spherie-$NAME" \
  -machine q35,accel=kvm -cpu host -smp "$CPUS" -m "$MEM" \
  -nodefaults -no-user-config -display none -vga none \
  -serial "file:$SPHERIE_RUN/$NAME.console.log" \
  -monitor none -qmp "unix:$SPHERIE_RUN/$NAME.qmp,server=on,wait=off" \
  -kernel "$SPHERIE_DATA/vmlinuz" -initrd "$SPHERIE_DATA/initramfs.img" \
  -append "$append" \
  -device "vhost-vsock-pci,guest-cid=$CID" \
  -device virtio-rng-pci \
  -sandbox on,obsolete=deny,elevateprivileges=deny,spawn=deny,resourcecontrol=deny \
  "${devices[@]}"
