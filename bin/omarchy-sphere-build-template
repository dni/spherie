#!/bin/bash

# omarchy:summary=Build the shared sphere template from scratch (needs host network)
# omarchy:requires-sudo=true

set -euo pipefail

sudo SPHERIE_DATA=/var/lib/spherie "$OMARCHY_PATH/template/build.sh" "$@"
sudo chown spherie:spherie /var/lib/spherie/template.qcow2 /var/lib/spherie/vmlinuz /var/lib/spherie/initramfs.img
